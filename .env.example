# Domain Configuration
NEXT_PUBLIC_INTERVIEW_DOMAIN=interviews.foloup.ai
NEXT_PUBLIC_MAIN_DOMAIN=foloup.com
NEXT_PUBLIC_LANDING_DOMAIN=foloup.com

NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
NEXT_PUBLIC_LIVE_URL=localhost:3000

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (all three from same project: Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Retell AI
RETELL_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Interview Silence Detection (in seconds)
# Time to wait after agent stops talking before showing warning message (second call)
NEXT_PUBLIC_SILENCE_WAIT_TIME=40
# Time to show warning message before displaying the modal
NEXT_PUBLIC_SILENCE_MESSAGE_TIME=5

# Two-Call System
# Duration of the first call in seconds (default: 10)
NEXT_PUBLIC_FIRST_CALL_DURATION=10
# Site domain for interview URLs
NEXT_PUBLIC_SITE_DOMAIN=

# Footer contact (marketing pages)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
